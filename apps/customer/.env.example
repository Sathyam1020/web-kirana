# Customer PWA — environment variables

# IP-3 — Google Maps Platform. Public key, restrict by HTTP referrer
# in the Google Cloud Console (customer.online-kirana.app/* +
# customer.localhost:3000/* for dev). Required for the location pill
# label + Add Address dialog autocomplete. The app degrades to plain
# text inputs when this is missing — it won't crash, but the UX
# regresses. See apps/backend/README.md "IP-3 Google Maps setup".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Internal API URL — used by Next.js rewrites to proxy /v1/* to the
# backend. Leave as-is for local dev.
API_INTERNAL_URL=http://localhost:4000

# Public-facing API origin — used by client-side fetch fallbacks when
# the proxy can't be used. Same as the browser-visible hostname for
# this app.
NEXT_PUBLIC_API_ORIGIN=http://customer.localhost:3000
