# Owner PWA — environment variables

# IP-3 — Google Maps Platform. Public key, restrict by HTTP referrer
# in the Google Cloud Console (owner.online-kirana.app/* +
# owner.localhost:3001/* for dev). Required for the onboarding
# address autocomplete. The form degrades to plain text inputs when
# this is missing. See apps/backend/README.md "IP-3 Google Maps setup".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Internal API URL — used by Next.js rewrites to proxy /v1/* to the
# backend. Leave as-is for local dev.
API_INTERNAL_URL=http://localhost:4000

# Public-facing API origin — used by client-side fetch fallbacks when
# the proxy can't be used.
NEXT_PUBLIC_API_ORIGIN=http://owner.localhost:3001
