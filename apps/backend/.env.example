# --- Runtime --------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (Postgres + PostGIS) ---------------------------------------
# Both URLs must point at databases with the postgis extension installed.
# Tests reset state between cases; never point TEST_DATABASE_URL at prod.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_TEST?sslmode=require

# --- CORS -----------------------------------------------------------------
# Comma-separated list of origins allowed to send credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Auth (added in Phase 3) ---------------------------------------------
# JWT_ACCESS_SECRET=
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30

# --- WhatsApp Cloud API (added in Phase 10) ------------------------------
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# --- Web Push (added in Phase 10) ----------------------------------------
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:ops@example.com

# --- Cloudinary (added in Phase 12) --------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Cron (added in Phase 11) --------------------------------------------
# AUTO_CANCEL_PLACED_TIMEOUT_MINUTES=15
