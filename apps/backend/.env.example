# Copy to .env and fill in. Var names must match src/config/env.ts exactly.

# --- Runtime --------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (Postgres + PostGIS + pg_trgm) -----------------------------
# DATABASE_URL = pooled (runtime, via @prisma/adapter-neon).
# DIRECT_URL   = unpooled (for `prisma migrate`; Neon: same URL without the
#                `-pooler` hostname suffix).
# Both databases need the postgis + pg_trgm extensions.
# TEST_DATABASE_URL: the suite mutates shared data — never point at prod.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB_TEST?sslmode=require

# --- Auth (better-auth, Phase 6.5) ---------------------------------------
# Min 32 chars (48 enforced in production). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Origin where this auth server is hosted (http://localhost:4000 in dev).
BETTER_AUTH_URL=http://localhost:4000
# Set in prod for cross-subdomain cookies on a shared apex (e.g. ".kirana.com").
# AUTH_COOKIE_DOMAIN=

# --- CORS -----------------------------------------------------------------
# Comma-separated allowlist; also better-auth trustedOrigins. REQUIRED in
# production (no localhost default there). Used by REST CORS AND the Socket.IO
# handshake — the socket connects cross-origin, so app origins must be listed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://customer.localhost:3000,http://owner.localhost:3001,http://admin.localhost:3002

# --- Cron (Phase 11) ------------------------------------------------------
# Orders left in PLACED this long are auto-cancelled.
ORDER_AUTO_CANCEL_MINUTES=30

# --- Cloudinary (Phase 6.7) — OPTIONAL, no-ops until all three set --------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Web Push (Phase 10) — OPTIONAL ---------------------------------------
# Generate: npx web-push generate-vapid-keys
# The frontends also need NEXT_PUBLIC_VAPID_PUBLIC_KEY (= VAPID_PUBLIC_KEY).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# --- WhatsApp Cloud API (Phase 10) — OPTIONAL -----------------------------
# Templates new_order_owner + order_cancelled_owner must be approved in Meta;
# see PHASE10.md. Webhook needs APP_SECRET (signature) + VERIFY_TOKEN.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v22.0
