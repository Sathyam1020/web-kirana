// Kirana marketplace schema.
//
// Money: integer paise everywhere (see Int *Paise fields).
// Time: persist UTC.
// PostGIS: `location geography(Point,4326)` on Store is added by a raw SQL
//   migration (Prisma does not model the geography type natively). The same
//   migration installs the postgis extension, adds the GiST index, and a
//   trigger that keeps location in sync with latitude/longitude.

// Prisma 7: the generated client lives at the `output` path below, and the
// datasource URL is configured in ../prisma.config.ts (CLI) + src/db/prisma.ts
// (runtime via @prisma/adapter-neon).
//
// ⚠️  PostGIS gotcha: Store.location and its GiST index `Store_location_gist_idx`
//     are managed by raw SQL in migrations/ (Prisma can't model GiST on
//     Unsupported columns). Every `prisma migrate dev --create-only` will
//     re-propose `DROP INDEX Store_location_gist_idx`; delete that line from
//     the generated migration before applying. The init migration is the
//     source of truth for the index.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums --------------------------------------------------------------

enum Role {
  CUSTOMER
  OWNER
  ADMIN
}

enum Unit {
  KG
  G
  L
  ML
  PIECE
  PACK
  DOZEN
}

enum OrderStatus {
  PLACED
  ACCEPTED
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  PENDING
  COLLECTED
}

enum ActorType {
  CUSTOMER
  OWNER
  SYSTEM
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  READ
}

// --- Identity -----------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  passwordHash String
  role         Role
  name         String

  // Approval gate: customers default to isApproved=true; owner signups are
  // created with isApproved=false and must be approved by an ADMIN before
  // login succeeds. Set on the row that performed the approval for audit.
  isApproved   Boolean  @default(true)
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?    @relation("UserApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[]  @relation("UserApprovedBy")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedStore         Store?              @relation("StoreOwner")
  refreshTokens      RefreshToken[]
  addresses          Address[]
  orders             Order[]             @relation("OrdersByCustomer")
  statusHistoryActs  OrderStatusHistory[] @relation("StatusActor")
  pushSubscriptions  PushSubscription[]
  idempotencyKeys    IdempotencyKey[]

  @@index([role])
  @@index([role, isApproved])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Opaque token stored hashed at rest. Lookup goes via tokenHash.
  tokenHash String   @unique

  // Family for chain-revoke on reuse detection: every refresh issues a new
  // token with the same familyId; a parent that's already replaced or revoked
  // means token reuse — revoke the whole family.
  familyId   String
  parentId   String?       @unique
  parent     RefreshToken? @relation("RefreshChain", fields: [parentId], references: [id])
  child      RefreshToken? @relation("RefreshChain")

  expiresAt DateTime
  revokedAt DateTime?

  userAgent String?
  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// --- Catalog ------------------------------------------------------------

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  displayOrder Int      @default(0)
  iconUrl      String?
  createdAt    DateTime @default(now())

  products Product[]
}

model Store {
  id          String  @id @default(cuid())
  ownerId     String  @unique
  owner       User    @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  description String?
  phone       String

  isActive    Boolean @default(true)
  isOpen      Boolean @default(false)

  // Stored coordinates; the geography column `location` is maintained by
  // a database trigger added in the PostGIS migration. Marked Unsupported
  // so Prisma knows it exists and won't try to drop it on the next migrate,
  // but it remains read/write-able only via raw SQL ($queryRaw / migrations).
  latitude    Decimal @db.Decimal(10, 7)
  longitude   Decimal @db.Decimal(10, 7)
  location    Unsupported("geography(Point, 4326)")?

  deliveryRadiusMeters Int @default(3000)
  minOrderPaise        Int @default(0)

  addressLine String
  city        String
  pincode     String
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  orders   Order[]

  @@index([isActive, isOpen])
  @@index([city])
}

model Product {
  id          String  @id @default(cuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  description String?
  pricePaise  Int
  unit        Unit
  imageUrl    String?

  // Soft delete: isActive=false means the product is hidden from the catalog
  // but remains for historical orders that reference it.
  isActive    Boolean @default(true)

  // Owner-toggled or reset nightly by the Phase 11 cron.
  isAvailable Boolean @default(true)

  // Phase 4.2 search:
  //  - searchAliases: owner-curated synonyms / cross-language tokens
  //    (e.g., ["dhaniya", "धनिया", "coriander leaves"]). Bounded to 20
  //    entries × 100 chars in the validation layer.
  //  - searchVector: tsvector maintained by the product_search_vector_update
  //    trigger from name + description + categoryName + storeName +
  //    searchAliases. Unsupported because Prisma can't model tsvector;
  //    served via raw SQL in the /v1/search/products endpoint.
  searchAliases String[] @default([])
  searchVector  Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([storeId, isActive])
  @@index([storeId, categoryId, isActive])
  @@index([storeId, isActive, isAvailable])
}

// --- Addresses ----------------------------------------------------------

model Address {
  id         String  @id @default(cuid())
  customerId String
  customer   User    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label      String
  line1      String
  line2      String?
  city       String
  pincode    String
  latitude   Decimal @db.Decimal(10, 7)
  longitude  Decimal @db.Decimal(10, 7)
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  // Only one default per customer is enforced at the service layer (a partial
  // unique index is added by raw SQL migration for the DB-side guard).
}

// --- Orders -------------------------------------------------------------

model Order {
  id          String       @id @default(cuid())
  customerId  String
  customer    User         @relation("OrdersByCustomer", fields: [customerId], references: [id], onDelete: Restrict)

  storeId     String
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)

  status        OrderStatus   @default(PLACED)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)

  itemsSubtotalPaise Int
  deliveryFeePaise   Int @default(0)
  totalPaise         Int

  // Snapshots — frozen at placement so historical orders survive store/profile edits.
  storeNameSnapshot     String
  storePhoneSnapshot    String
  customerNameSnapshot  String
  customerPhoneSnapshot String
  deliveryLabel         String
  deliveryLine1         String
  deliveryLine2         String?
  deliveryCity          String
  deliveryPincode       String
  deliveryLatitude      Decimal @db.Decimal(10, 7)
  deliveryLongitude     Decimal @db.Decimal(10, 7)

  customerNote String?

  // Lifecycle timestamps; the canonical record of transitions lives in
  // OrderStatusHistory. These mirror the latest entry for convenience.
  placedAt          DateTime  @default(now())
  acceptedAt        DateTime?
  outForDeliveryAt  DateTime?
  deliveredAt       DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?

  rejectionReason   String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  history OrderStatusHistory[]

  @@index([customerId, status])
  @@index([storeId, status])
  @@index([status, placedAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot — never re-read from Product after placement.
  productNameSnapshot     String
  productImageUrlSnapshot String?
  unitPricePaiseSnapshot  Int
  unitSnapshot            Unit

  quantity       Int
  lineTotalPaise Int

  // Modify flow (Phase 8): owner may mark an item removed without deleting it,
  // preserving the audit trail. Subtotals recalculate ignoring isRemoved=true.
  isRemoved Boolean   @default(false)
  removedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model OrderStatusHistory {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus

  actorType   ActorType
  actorUserId String?
  actorUser   User?     @relation("StatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  reason    String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// --- Idempotency --------------------------------------------------------

model IdempotencyKey {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Scope groups keys per endpoint so the same client key can be reused
  // across different actions without colliding.
  scope     String
  key       String

  // sha256(canonical(request body)) — replays with a different body get rejected.
  requestFingerprint String

  responseStatusCode Int
  responseBody       Json

  // Convenience pointer when the action created a known resource (used by orders).
  orderId String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([userId, scope, key])
  @@index([expiresAt])
}

// --- Notifications ------------------------------------------------------

model WhatsAppMessageLog {
  id           String                @id @default(cuid())
  toPhone      String
  templateName String
  payload      Json
  status       WhatsAppMessageStatus @default(PENDING)
  waMessageId  String?               @unique
  errorCode    String?
  errorMessage String?
  attempts     Int                   @default(0)
  lastAttemptAt DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status, createdAt])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?

  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([userId])
}
