// Kirana marketplace schema.
//
// Money: integer paise everywhere (see Int *Paise fields).
// Time: persist UTC.
// PostGIS: `location geography(Point,4326)` on Store is added by a raw SQL
//   migration (Prisma does not model the geography type natively). The same
//   migration installs the postgis extension, adds the GiST index, and a
//   trigger that keeps location in sync with latitude/longitude.

// Prisma 7: the generated client lives at the `output` path below, and the
// datasource URL is configured in ../prisma.config.ts (CLI) + src/db/prisma.ts
// (runtime via @prisma/adapter-neon).
//
// ⚠️  PostGIS gotcha: Store.location and its GiST index `Store_location_gist_idx`
//     are managed by raw SQL in migrations/ (Prisma can't model GiST on
//     Unsupported columns). Every `prisma migrate dev --create-only` will
//     re-propose `DROP INDEX Store_location_gist_idx`; delete that line from
//     the generated migration before applying. The init migration is the
//     source of truth for the index.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums --------------------------------------------------------------

enum Role {
  CUSTOMER
  OWNER
  ADMIN
}

enum Unit {
  KG
  G
  L
  ML
  PIECE
  PACK
  DOZEN
}

enum OrderStatus {
  PLACED
  ACCEPTED
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  PENDING
  COLLECTED
}

enum ActorType {
  CUSTOMER
  OWNER
  SYSTEM
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  READ
}

// Phase 4.3 — coupons
enum CouponType {
  PERCENT // value is 1..100 (interpreted as a percentage)
  FLAT_PAISE // value is the absolute discount in paise
}

enum CouponScope {
  GLOBAL // any store; created by admin only
  STORE // scoped to one store; created by that store's owner
}

// --- Identity -----------------------------------------------------------

// User is owned by better-auth (Phase 6.5). Better-auth requires the
// id/email/name/emailVerified/image/createdAt/updatedAt columns; everything
// else here is our `additionalFields` declared in lib/auth.ts:
//   phone (unique, normalized), role, isApproved, approvedAt, approvedById.
// All domain relations (Store, Address, Order, etc.) stay attached.
model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // Custom additional fields — input/required configured in lib/auth.ts.
  phone String @unique
  role  Role   @default(CUSTOMER)

  // Approval gate: customers default to isApproved=true; owner signups are
  // created with isApproved=false and must be approved by an ADMIN before
  // login succeeds (enforced in the session.create hook in lib/auth.ts).
  isApproved    Boolean   @default(true)
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?     @relation("UserApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[]    @relation("UserApprovedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Better-auth-managed
  sessions Session[]
  accounts Account[]

  // Domain relations (unchanged)
  ownedStore        Store?               @relation("StoreOwner")
  addresses         Address[]
  orders            Order[]              @relation("OrdersByCustomer")
  statusHistoryActs OrderStatusHistory[] @relation("StatusActor")
  pushSubscriptions PushSubscription[]
  idempotencyKeys   IdempotencyKey[]

  // Phase 4.3 — coupons
  couponsCreated    Coupon[]           @relation("CouponCreatedBy")
  couponRedemptions CouponRedemption[]

  @@index([role])
  @@index([role, isApproved])
}

// Better-auth: per-device session row. Cookie carries the session token,
// DB lookup gives us the user. Sliding expiry per lib/auth.ts session config.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// Better-auth: per-provider account row. For email+password we have one
// per user with providerId="credential" and password=<bcrypt hash>.
// Future OAuth providers (Google, etc.) would add additional rows here.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

// Better-auth: short-lived tokens (email verification, password reset, etc.).
// Unused today; required by the schema contract.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// --- Catalog ------------------------------------------------------------

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  displayOrder Int      @default(0)
  iconUrl      String?
  createdAt    DateTime @default(now())

  products Product[]
}

model Store {
  id      String @id @default(cuid())
  ownerId String @unique
  owner   User   @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  description String?
  phone       String

  isActive Boolean @default(true)
  isOpen   Boolean @default(false)

  // Stored coordinates; the geography column `location` is maintained by
  // a database trigger added in the PostGIS migration. Marked Unsupported
  // so Prisma knows it exists and won't try to drop it on the next migrate,
  // but it remains read/write-able only via raw SQL ($queryRaw / migrations).
  latitude  Decimal                                @db.Decimal(10, 7)
  longitude Decimal                                @db.Decimal(10, 7)
  location  Unsupported("geography(Point, 4326)")?

  deliveryRadiusMeters Int @default(3000)
  minOrderPaise        Int @default(0)

  addressLine String
  city        String
  pincode     String
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  orders   Order[]
  coupons  Coupon[]

  @@index([isActive, isOpen])
  @@index([city])
}

model Product {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  description String?
  pricePaise  Int
  unit        Unit
  imageUrl    String?

  // Soft delete: isActive=false means the product is hidden from the catalog
  // but remains for historical orders that reference it.
  isActive Boolean @default(true)

  // Owner-toggled or reset nightly by the Phase 11 cron.
  isAvailable Boolean @default(true)

  // Phase 4.3 — merchandising hooks.
  //  Featured: owner-controlled, within their store. featuredOrder is
  //  an ascending sort key (lower = more prominent); null means "not
  //  pinned". Phase 5 store detail surfaces featured rows first.
  isFeatured    Boolean @default(false)
  featuredOrder Int?

  //  Promoted: admin-controlled, marketplace-wide. Phase 4.2 search +
  //  Phase 5 discovery use the (isPromoted, promotedUntil) pair to
  //  multiply the score for products that are still in the window.
  //  No cleanup cron — the timestamp check auto-expires the boost.
  isPromoted    Boolean   @default(false)
  promotedUntil DateTime?

  // Phase 4.2 search:
  //  - searchAliases: owner-curated synonyms / cross-language tokens
  //    (e.g., ["dhaniya", "धनिया", "coriander leaves"]). Bounded to 20
  //    entries × 100 chars in the validation layer.
  //  - searchVector: tsvector maintained by the product_search_vector_update
  //    trigger from name + description + categoryName + storeName +
  //    searchAliases. Unsupported because Prisma can't model tsvector;
  //    served via raw SQL in the /v1/search/products endpoint.
  searchAliases String[]                 @default([])
  searchVector  Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([storeId, isActive])
  @@index([storeId, categoryId, isActive])
  @@index([storeId, isActive, isAvailable])
  // Phase 4.3 — featured pins surface first in store detail
  @@index([storeId, isFeatured, featuredOrder])
  // Promotion expiry check happens often in search/discovery
  @@index([isPromoted, promotedUntil])
}

// --- Addresses ----------------------------------------------------------

model Address {
  id         String @id @default(cuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label     String
  line1     String
  line2     String?
  city      String
  pincode   String
  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Only one default per customer is enforced at the service layer (a partial
  // unique index is added by raw SQL migration for the DB-side guard).

  @@index([customerId])
}

// --- Orders -------------------------------------------------------------

model Order {
  id         String @id @default(cuid())
  customerId String
  customer   User   @relation("OrdersByCustomer", fields: [customerId], references: [id], onDelete: Restrict)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  status        OrderStatus   @default(PLACED)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)

  itemsSubtotalPaise Int
  deliveryFeePaise   Int @default(0)
  totalPaise         Int

  // Snapshots — frozen at placement so historical orders survive store/profile edits.
  storeNameSnapshot     String
  storePhoneSnapshot    String
  customerNameSnapshot  String
  customerPhoneSnapshot String
  deliveryLabel         String
  deliveryLine1         String
  deliveryLine2         String?
  deliveryCity          String
  deliveryPincode       String
  deliveryLatitude      Decimal @db.Decimal(10, 7)
  deliveryLongitude     Decimal @db.Decimal(10, 7)

  customerNote String?

  // Lifecycle timestamps; the canonical record of transitions lives in
  // OrderStatusHistory. These mirror the latest entry for convenience.
  placedAt         DateTime  @default(now())
  acceptedAt       DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  rejectedAt       DateTime?
  cancelledAt      DateTime?

  rejectionReason    String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  history OrderStatusHistory[]

  // Phase 4.3 — at most one coupon per order (Phase 7 enforces in tx).
  // The relation is optional; null = no coupon used.
  couponRedemption CouponRedemption?

  @@index([customerId, status])
  @@index([storeId, status])
  @@index([status, placedAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot — never re-read from Product after placement.
  productNameSnapshot     String
  productImageUrlSnapshot String?
  unitPricePaiseSnapshot  Int
  unitSnapshot            Unit

  quantity       Int
  lineTotalPaise Int

  // Modify flow (Phase 8): owner may mark an item removed without deleting it,
  // preserving the audit trail. Subtotals recalculate ignoring isRemoved=true.
  isRemoved Boolean   @default(false)
  removedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus

  actorType   ActorType
  actorUserId String?
  actorUser   User?     @relation("StatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  reason    String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// --- Idempotency --------------------------------------------------------

model IdempotencyKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Scope groups keys per endpoint so the same client key can be reused
  // across different actions without colliding.
  scope String
  key   String

  // sha256(canonical(request body)) — replays with a different body get rejected.
  requestFingerprint String

  responseStatusCode Int
  responseBody       Json

  // Convenience pointer when the action created a known resource (used by orders).
  orderId String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([userId, scope, key])
  @@index([expiresAt])
}

// --- Notifications ------------------------------------------------------

model WhatsAppMessageLog {
  id            String                @id @default(cuid())
  toPhone       String
  templateName  String
  payload       Json
  status        WhatsAppMessageStatus @default(PENDING)
  waMessageId   String?               @unique
  errorCode     String?
  errorMessage  String?
  attempts      Int                   @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status, createdAt])
}

model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String  @unique
  p256dh    String
  auth      String
  userAgent String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// --- Coupons (Phase 4.3) ------------------------------------------------

model Coupon {
  id    String     @id @default(cuid())
  code  String     @unique
  type  CouponType
  // PERCENT: value is 1..100 (percent of subtotal)
  // FLAT_PAISE: value is the discount in paise
  value Int

  scope   CouponScope
  // Required when scope = STORE. NULL for GLOBAL.
  storeId String?
  store   Store?      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Cap on PERCENT-type discounts (e.g., "50% off, max ₹100"). Ignored
  // for FLAT_PAISE.
  maxDiscountPaise Int?
  minOrderPaise    Int  @default(0)

  validFrom  DateTime  @default(now())
  validUntil DateTime?

  isActive Boolean @default(true)

  // null = unlimited. Phase 7 enforces via the redemption table count.
  totalUsageLimit Int?
  perUserLimit    Int  @default(1)
  // Maintained atomically by Phase 7 inside the order tx.
  usageCount      Int  @default(0)

  createdById String
  createdBy   User   @relation("CouponCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([scope, isActive])
  @@index([storeId, isActive])
  @@index([code, isActive])
}

model CouponRedemption {
  id       String @id @default(cuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One redemption row per Order — uniqueness here is what prevents
  // double-apply on a single order.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  discountAppliedPaise Int

  createdAt DateTime @default(now())

  @@index([userId, couponId])
  @@index([couponId, createdAt])
}
